    {"id":"okcallout","type":"text","x":60,"y":532,"width":1460,"height":50,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":18001,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"要点:INOE 后端用它自己记着的手机号换出「一次性票」;浏览器只带票跳转,票被改就立刻失效。手机号全程只在两边后端之间走。","fontSize":18,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"要点:INOE 后端用它自己记着的手机号换出「一次性票」;浏览器只带票跳转,票被改就立刻失效。手机号全程只在两边后端之间走。","lineHeight":1.25},

