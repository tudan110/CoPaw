    {"id":"sumtext","type":"text","x":80,"y":616,"width":1420,"height":50,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":19002,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"一句话:手机号必须「后台递给后台」,绝不能让「浏览器」经手。\n你的思路对 —— 身份确实要从 INOE 流到 portal,只是不走浏览器明文。","fontSize":18,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"一句话:手机号必须「后台递给后台」,绝不能让「浏览器」经手。\n你的思路对 —— 身份确实要从 INOE 流到 portal,只是不走浏览器明文。","lineHeight":1.25}
