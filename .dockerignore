# Git and IDE
.git
.gitignore
.idea
.vscode
*.md
!README.md

# Python dev and cache
__pycache__
*.py[cod]
*$py.class
.venv
venv
uv.lock
.pytest_cache
.coverage
htmlcov
.tox
.mypy_cache
.ruff_cache

# Tests (not needed in runtime image)
tests
test.py
*_test.py
pytest.ini
.pre-commit-config.yaml
.flake8
.eslintrc
.stylelintrc

# Frontend: exclude build artifacts; ship pre-built src/console/dist in image
website
!website/
!website/public/
!website/public/docs/
!website/public/docs/**
console/node_modules
console/dist
console/.vite
node_modules
**/node_modules
**/dist
!src/qwenpaw/console/dist
!src/qwenpaw/console/dist/**
**/.vite

# Example and local config (mount at runtime instead)
example
config.json
jobs.json
sessions_mount_dir

# Misc
.env
.env.*
!.env.example
!deploy-all/copaw/data/copaw/workspaces/*/skills/*/.env
!deploy-all/copaw/data/copaw/workspaces/*/skills/*/.env.example
.DS_Store
*.log
logs
cookbook

# Universal QwenPaw seed inputs. The generic image builds these into a
# runtime-neutral working-directory seed, so these tracked source files must
# remain in the Docker context despite the broad rules above.
!deploy-all/
!deploy-all/qwenpaw/
!deploy-all/qwenpaw/working/
!deploy-all/qwenpaw/working/**
!deploy-all/qwenpaw/scripts/
!deploy-all/qwenpaw/scripts/**
!src/qwenpaw/agents/
!src/qwenpaw/agents/skills/
!src/qwenpaw/agents/skills/**
!src/qwenpaw/agents/md_files/
!src/qwenpaw/agents/md_files/**
# Never re-include real local credentials while unignoring working sources.
deploy-all/qwenpaw/working/**/.env
# Keep runtime data out of the build context. Provider configuration is an
# explicit product decision: qwenpaw.secret is bundled with this image so a
# fresh deployment has a ready-to-use model configuration.
!deploy-all/qwenpaw/data/
deploy-all/qwenpaw/data/**
!deploy-all/qwenpaw/data/qwenpaw.secret/
!deploy-all/qwenpaw/data/qwenpaw.secret/**
