# log-security-scan 配置（与 nightingale-log 同源，独立加载）
# 复制为 .env 后填入实际值

N9E_API_BASE_URL=http://192.168.130.51:17001
N9E_USER_TOKEN=your_user_token_here
N9E_LOG_DATASOURCE_ID=1
N9E_LOG_INDEX=casaos-syslog-*
N9E_LOG_TIMESTAMP_FIELD=@timestamp

# 单次拉取上限（max-docs 的硬天花板）
N9E_LOG_MAX_SIZE=10000
N9E_LOG_TIMEOUT=60

# N9E_USE_HTTP_PROXY=false

# ---- log-security-scan 专属（可选） ----
# 自定义规则文件路径（不设则使用 references/security_rules.yml）
# SECURITY_RULES_FILE=/abs/path/to/custom_rules.yml

# 单次扫描的硬上限（覆盖 --max-docs 的最大值）
# SECURITY_SCAN_MAX_DOCS=8000

# 默认 redact_keep（也可在规则文件 defaults 里覆盖）
# SECURITY_REDACT_KEEP=2
