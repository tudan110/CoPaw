# log-hazard-detection 配置（与 nightingale-log 同源，但独立加载）
# 复制为 .env 后填入实际值

# 夜莺前端地址（不带末尾斜杠，包含 http(s):// 前缀）
N9E_API_BASE_URL=http://192.168.130.51:17001

# 夜莺个人中心 -> Token 管理 创建出的 X-User-Token
N9E_USER_TOKEN=your_user_token_here

# 默认日志 ES 数据源 ID（在 “数据查询 -> 日志” 页面看到的 _msearch 路径里的数字）
N9E_LOG_DATASOURCE_ID=1

# 默认索引（建议显式指定业务日志索引模式，例如 casaos-syslog-*、filebeat-*）
N9E_LOG_INDEX=casaos-syslog-*

# 默认时间字段名（ES 里的 @timestamp 字段）
N9E_LOG_TIMESTAMP_FIELD=@timestamp

# 单次查询最大命中数（drain3 抽样硬上限；默认 500，建议至少 2000）
N9E_LOG_MAX_SIZE=5000

# 请求超时（秒）；drain3 模板挖掘比一般查询稍慢
N9E_LOG_TIMEOUT=60

# 是否走 shell 的 http_proxy / https_proxy（默认 false）
# n9e 多数情况下是内网部署，开发机的出网代理会让请求超时。
# N9E_USE_HTTP_PROXY=false

# ---- log-hazard-detection 专属（可选） ----
# drain3 单次最大簇数兜底；超过后不再分裂，合并入 *
# HAZARD_TEMPLATE_LIMIT=2000

# 默认抽样大小（脚本 --sample-size 的兜底）
# HAZARD_SAMPLE_SIZE=2000

# 默认基线偏移（漂移分析的默认 lookback）
# HAZARD_BASELINE_LOOKBACK=24h
