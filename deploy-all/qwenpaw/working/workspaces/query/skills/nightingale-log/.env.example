# 夜莺监控（Nightingale / n9e）日志查询技能配置
# 复制为 .env 后填入实际值

# 夜莺前端地址（不带末尾斜杠，包含 http(s):// 前缀）
N9E_API_BASE_URL=

# 夜莺个人中心 -> Token 管理 创建出的 X-User-Token
N9E_USER_TOKEN=your_user_token_here

# 默认日志 ES 数据源 ID（在 “数据查询 -> 日志” 页面看到的 _msearch 路径里的数字）
# 例如 /api/n9e/proxy/1/_msearch 表示 ID = 1
N9E_LOG_DATASOURCE_ID=1

# 默认索引（支持通配符；建议显式指定，例如 logstash-*、filebeat-*、app-logs-*）
N9E_LOG_INDEX=*

# 默认时间字段名（ES 里的 @timestamp 字段）
N9E_LOG_TIMESTAMP_FIELD=@timestamp

# 默认级别字段（按你的索引实际字段名填，常见有 level / log.level / severity）
# 留空时聚合接口会自动尝试 log.level、level、severity
# N9E_LOG_LEVEL_FIELD=

# 默认主机字段（常见有 host.name / hostname / agent.hostname / nodename）
# N9E_LOG_HOST_FIELD=

# 默认服务字段（常见有 service.name / service / app）
# N9E_LOG_SERVICE_FIELD=

# 单次查询最大命中数（保险阀，默认 500）
# N9E_LOG_MAX_SIZE=500

# 请求超时（秒）
# N9E_LOG_TIMEOUT=30

# 是否走 shell 的 http_proxy / https_proxy（默认 false）
# n9e 多数情况下是内网部署，开发机的出网代理会让请求超时。
# 仅当夜莺真的必须经过某个代理才能访问时才设为 true。
# N9E_USE_HTTP_PROXY=false
