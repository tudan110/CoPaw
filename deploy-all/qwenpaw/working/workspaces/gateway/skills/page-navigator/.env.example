# Page Navigator 配置示例
#
# 菜单接口与告警/监控同属 INOE 后端,优先复用共享 secrets/inoe.env 里的
# INOE_API_BASE_URL / INOE_API_TOKEN(本技能子进程会继承 agent 进程已注入
# 的环境)。只有当菜单接口根地址与告警不同、或需要单独覆盖时,才在这里或
# secrets/inoe.env 里设置下面的菜单专属变量。所有项都有默认值。

# 菜单接口根地址。缺省回退 INOE_API_BASE_URL。
# 例:http://gateway:8080
# INOE_MENU_BASE_URL=

# 鉴权 token。缺省复用 INOE_API_TOKEN。可带或不带 "Bearer " 前缀。
# INOE_MENU_TOKEN=

# getRouters/{app} 里的应用编码。默认 inoe。
# INOE_MENU_APP_CODE=inoe

# 拉取超时(秒)。默认 20。
# INOE_MENU_TIMEOUT_SECONDS=20

# 菜单内存缓存 TTL(秒)。默认 600。
# INOE_MENU_CACHE_TTL_SECONDS=600
