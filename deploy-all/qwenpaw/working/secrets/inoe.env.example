# INOE 网关共享凭证（统一管理）
#
# 复制本文件为同目录下的 inoe.env 并填入真实值。inoe.env 不入库（见 .gitignore）。
# 解析优先级（同名 key，高 → 低）：
#   1. 真实进程环境变量 / export / 后端 qwenpaw env 存储
#   2. 本共享文件 secrets/inoe.env（新逻辑，统一来源）
#   3. 各 skill 目录下的 .env（旧配置，兼容；独立运行 skill 时作为可选覆盖）
#
# 注意：base url 直连网关，不要带 /prod-api（那是前端 nginx 前缀）。

INOE_API_BASE_URL=http://<host>:<port>
INOE_API_TOKEN=your_jwt_token_here
INOE_ENABLE_CURL_FALLBACK=true
