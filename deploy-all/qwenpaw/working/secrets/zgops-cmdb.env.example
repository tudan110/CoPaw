# 当前仅 zgops-cmdb-import skill 会 fallback 到这里。
# 其它 zgops-cmdb skill (gateway/inspection/query/fault) 仍读各自
# skill 目录下的 .env，不受本文件影响。
#
# 复制本文件为同目录的 zgops-cmdb.env 并填入真实值。
# 该位置随 sync-qwenpaw-working.sh 同步到 ~/.qwenpaw/secrets/，
# 让 zgops-cmdb-import 的凭证位置与 skill 目录命名解耦——
# 以后 rename 这个 skill 不会再丢凭证。
#
# 解析顺序（仅 zgops-cmdb-import 走这条 cascade）：
#   $VEOPS_ENV_FILE
#   → <skill_dir>/.env
#   → $QWENPAW_WORKING_DIR/secrets/zgops-cmdb.env
#   → ~/.qwenpaw/secrets/zgops-cmdb.env
#   → <repo>/deploy-all/qwenpaw/working/secrets/zgops-cmdb.env

VEOPS_BASE_URL=http://82.156.83.38:31089
VEOPS_USERNAME=admin
VEOPS_PASSWORD=replace-me
VEOPS_SESSION_NAME=veops-cmdb

# 资源导入 skill 专用：LLM 字段映射 / 视觉解析配置
# 留空时 zgops-cmdb-import 会回退到 agent 的默认 LLM 客户端。
RESOURCE_IMPORT_LLM_BASE_URL=
RESOURCE_IMPORT_LLM_API_KEY=
RESOURCE_IMPORT_LLM_MODEL=
RESOURCE_IMPORT_LLM_VISION_MODEL=
