# 共享 CMDB 凭证（所有 zgops-cmdb 系列 skill 默认 fallback 读取这里）
# 复制本文件为同目录的 zgops-cmdb.env 并填入真实值。
# 该位置随 sync-qwenpaw-working.sh 同步到 ~/.qwenpaw/secrets/，
# 与 skill 目录命名解耦——以后 rename skill 不会再丢凭证。
#
# 单 skill 如果需要覆盖共享凭证，仍可在该 skill 目录下放 .env，
# 解析顺序：$VEOPS_ENV_FILE → <cwd>/.env → $QWENPAW_WORKING_DIR/secrets/zgops-cmdb.env → ~/.qwenpaw/secrets/zgops-cmdb.env → <repo>/deploy-all/qwenpaw/working/secrets/zgops-cmdb.env

VEOPS_BASE_URL=http://192.168.130.51:31089
VEOPS_USERNAME=admin
VEOPS_PASSWORD=replace-me
VEOPS_SESSION_NAME=veops-cmdb

# 资源导入 skill 专用：LLM 字段映射 / 视觉解析配置
# 留空时 zgops-cmdb-import 会回退到 agent 的默认 LLM 客户端。
RESOURCE_IMPORT_LLM_BASE_URL=
RESOURCE_IMPORT_LLM_API_KEY=
RESOURCE_IMPORT_LLM_MODEL=
RESOURCE_IMPORT_LLM_VISION_MODEL=
