INOE_API_BASE_URL=http://192.168.130.51:30080
INOE_API_TOKEN=your_jwt_token_here
INOE_API_TIMEOUT=60
# Portal 告警列表接口的前台等待超时，超时后会返回缓存或 mock，避免拖慢整个服务。
QWENPAW_PORTAL_REAL_ALARM_ROUTE_TIMEOUT=5
# Portal 告警列表缓存 TTL，单位为秒。
QWENPAW_PORTAL_REAL_ALARM_CACHE_TTL=30
# 告警后端异常后的降级冷却时间，单位为秒；冷却期间优先返回缓存或 mock。
QWENPAW_PORTAL_REAL_ALARM_DEGRADED_COOLDOWN=30
# 是否开启 Portal 告警自动接管。
QWENPAW_PORTAL_REAL_ALARM_AUTO_TAKEOVER_ENABLED=true
# 轮询间隔，单位为秒；小于 60 秒会按 60 秒处理。
QWENPAW_PORTAL_REAL_ALARM_AUTO_TAKEOVER_INTERVAL=300
# 每轮轮询最多抓取的告警数量。
QWENPAW_PORTAL_REAL_ALARM_AUTO_TAKEOVER_LIMIT=20
# 告警分析最大并发数，默认值为 1。
QWENPAW_PORTAL_REAL_ALARM_MAX_ACTIVE_ANALYSES=1
# 告警查询回溯时间（小时），默认 24 小时，避免首次部署时大量历史告警冲击
QWENPAW_PORTAL_REAL_ALARM_LOOKBACK_HOURS=24
# 告警平台接口时区偏移（小时），默认东八区
QWENPAW_PORTAL_REAL_ALARM_TIMEZONE_OFFSET=8

# 启明大模型 OpenAI 风格适配层配置。
QWENPAW_QIMING_BASE_URL=http://10.130.154.233:30000
QWENPAW_QIMING_COMPLETIONS_PATH=/serviceAgent/rest/wsc/completions
QWENPAW_QIMING_APP_ID=your_qiming_app_id
QWENPAW_QIMING_APP_KEY=your_qiming_app_key
QWENPAW_QIMING_BEARER_TOKEN=your_qiming_bearer_token
QWENPAW_QIMING_MODELS=qiming25_72b_fc

# 星辰大模型 OpenAI 风格适配层配置。
QWENPAW_XINGCHEN_BASE_URL=https://openapi.teleagi.cn:443
QWENPAW_XINGCHEN_CHAT_PATH=/aipaas/lm/v1/telechat/chat115b
QWENPAW_XINGCHEN_APP_ID=your_xingchen_app_id
QWENPAW_XINGCHEN_ORDER_NUM=your_xingchen_order_num
QWENPAW_XINGCHEN_AUTHORIZATION=your_xingchen_authorization
QWENPAW_XINGCHEN_MODELS=telechat-115b
