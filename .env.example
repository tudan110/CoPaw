INOE_API_BASE_URL=http://192.168.130.51:30080
INOE_API_TOKEN=your_jwt_token_here
INOE_API_TIMEOUT=60
# 是否开启 Portal 告警自动接管。
QWENPAW_PORTAL_REAL_ALARM_AUTO_TAKEOVER_ENABLED=true
# 轮询间隔，单位为秒；小于 60 秒会按 60 秒处理。
QWENPAW_PORTAL_REAL_ALARM_AUTO_TAKEOVER_INTERVAL=300
# 每轮轮询最多抓取的告警数量。
QWENPAW_PORTAL_REAL_ALARM_AUTO_TAKEOVER_LIMIT=20
# 告警分析最大并发数，默认值为 1。
QWENPAW_PORTAL_REAL_ALARM_MAX_ACTIVE_ANALYSES=1
